{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Meetily Plus",
    "version": "0.4.3",
    "identifier": "com.meetily.ai",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://localhost:3118",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "title": "Meetily Plus",
                "width": 1100,
                "height": 700,
                "resizable": true,
                "fullscreen": false,
                "theme": "Light",
                "decorations": true
            }
        ],
        "macOSPrivateApi": true,
        "security": {
            "csp": {
                "default-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' data:",
                "connect-src": "'self' ipc: http://ipc.localhost"
            },
            "capabilities": [
                {
                    "identifier": "main",
                    "description": "Main window capability with the minimum local APIs required by the audited fork",
                    "windows": [
                        "main"
                    ],
                    "permissions": [
                        "core:path:default",
                        "core:event:default",
                        "core:window:default",
                        "core:app:default",
                        "core:resources:default",
                        "core:menu:default",
                        "core:tray:default",
                        "core:window:allow-set-title",
                        "store:default",
                        "notification:default",
                        "notification:allow-is-permission-granted",
                        "global-shortcut:allow-register",
                        "global-shortcut:allow-unregister",
                        "global-shortcut:allow-is-registered"
                    ]
                }
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb",
            "appimage",
            "msi",
            "nsis",
            "app",
            "dmg"
        ],
        "createUpdaterArtifacts": false,
        "icon": [
            "icons/icon.png",
            "icons/app_icon.icns",
            "icons/app_icon.ico"
        ],
        "resources": [
            "templates/*.json",
            "binaries/FFMPEG-PROVENANCE.md",
            "binaries/SIDECAR-PROVENANCE.md",
            "binaries/COPYING.LGPLv2.1",
            "vendor/onnxruntime/PROVENANCE.md",
            "vendor/onnxruntime/LICENSE"
        ],
        "externalBin": [
            "binaries/llama-helper",
            "binaries/diarization-helper",
            "binaries/ffmpeg"
        ],
        "macOS": {
            "entitlements": "entitlements.plist",
            "hardenedRuntime": true,
            "minimumSystemVersion": "14.2"
        },
        "windows": {
            "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1"
        }
    }
}
