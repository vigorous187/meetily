// Keep Xcode-generated caches inside writable temporary storage when Cargo is
// running in a workspace-only sandbox. Release CI may override these paths.
CLANG_MODULE_CACHE_PATH = /tmp/meetily-xcode-cache/modules
SWIFT_MODULECACHE_PATH = /tmp/meetily-xcode-cache/swift
MODULE_CACHE_DIR = /tmp/meetily-xcode-cache/modules
OBJROOT = /tmp/meetily-xcode-cache/obj
SHARED_PRECOMPS_DIR = /tmp/meetily-xcode-cache/modules
COMPILER_INDEX_STORE_ENABLE = NO
INDEX_ENABLE_DATA_STORE = NO
